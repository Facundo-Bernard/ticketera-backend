# Configuración de Caddy Reverse Proxy para Frontend (dist) y Backend (FastAPI)
# Puerto 8085 (HTTP directo / Reverse Proxy)
:8085 {
    root * /srv
    encode gzip zstd

    # Logging estructurado en consola
    log {
        output stdout
        format console
    }

    # Encabezados de seguridad HTTP recomendados (Hardening)
    header {
        # Evitar ataques de clickjacking
        X-Frame-Options "SAMEORIGIN"
        # Prevenir MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Protección de referrers
        Referrer-Policy "strict-origin-when-cross-origin"
        # Ocultar la firma del servidor web para evitar fingerprinting
        -Server
    }

    # 1. Enrutar API, Health y Documentación Swagger al contenedor de Backend
    handle /api/* {
        reverse_proxy backend:8085 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    handle /health* {
        reverse_proxy backend:8085
    }

    handle /docs* {
        reverse_proxy backend:8085
    }

    handle /openapi.json {
        reverse_proxy backend:8085
    }

    handle /redoc* {
        reverse_proxy backend:8085
    }

    # 2. Servir Frontend y fallback SPA exclusivo para rutas que no son del backend
    handle {
        try_files {path} /index.html
        file_server
    }
}

# OPCIONAL (HTTPS Automático):
# Si deseas que Caddy gestione automáticamente SSL/TLS con tu dominio DuckDNS:
# ticketscoopya.duckdns.org:8085 {
#     tls internal # o tu email para Let's Encrypt / ZeroSSL
#     encode gzip zstd
#     reverse_proxy backend:8085
# }
