# Configuración de Caddy Reverse Proxy para Frontend (dist) y Backend (FastAPI)
# Puerto 8085 (HTTP directo / Reverse Proxy)
:8085 {
    root * /srv
    encode gzip zstd

    # Logging estructurado en consola
    log {
        output stdout
        format console
    }

    # Encabezados globales de seguridad (Hardening)
    header {
        # Ocultar la firma del servidor web para evitar fingerprinting
        -Server

        # Prevención de ataques MIME-sniffing
        X-Content-Type-Options "nosniff"

        # Protección contra ataques de Clickjacking
        X-Frame-Options "DENY"

        # Control de fuga de información en la cabecera Referer
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restricción de APIs sensibles del navegador
        Permissions-Policy "camera=(), microphone=(), geolocation=()"

        # Forzar transporte seguro (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Protección contra Payloads excesivos (Anti-DoS / mitigación de desbordamiento de memoria)
    request_body {
        max_size 10MB
    }

    # Bloquear acceso a archivos y directorios ocultos (.env, .git, etc.)
    @hidden {
        path */.*
        path .*
    }
    respond @hidden 404

    # Bloquear rutas de documentación técnica (Swagger / OpenAPI / ReDoc)
    @docs path /docs* /redoc* /openapi.json
    respond @docs 404

    # Aislamiento de la aplicación mediante Proxy Inverso explícito hacia FastAPI
    @backend path /api/* /health*
    handle @backend {
        reverse_proxy backend:8085 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1
        }
    }

    # Servir Frontend y fallback SPA exclusivo para rutas que no son del backend
    handle {
        try_files {path} /index.html
        file_server
    }
}
