# Configuración de Base de Datos MongoDB
MONGO_ROOT_USER=admin_central
MONGO_ROOT_PASSWORD=DefinirContrasenaMongoAqui
MONGO_HOST=mongodb-central
MONGO_PORT=27017
MONGO_DB_NAME=tickets_db
MONGO_AUTH_SOURCE=admin
MONGO_URI=mongodb://admin_central:DefinirContrasenaMongoAqui@mongodb-central:27017/tickets_db?authSource=admin

# Orígenes CORS permitidos para el Frontend
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://localhost:8085", "https://admin.asistodo.com.ar", "https://ticketera.asistodo.com.ar"]

# Seguridad y Cuotas por Correo
MAX_DAILY_TICKETS_PER_EMAIL=8
TICKET_CREATION_COOLDOWN_SECONDS=60

# Lista blanca de administradores (sin límites de creación ni cooldown)
ADMIN_EMAILS=["admin@sistemas.com"]

# Cuenta Maestra de Administrador (Solo usada en primer seed de base de datos vacía)
MASTER_ADMIN_EMAIL=admin@sistemas.com
MASTER_ADMIN_PASSWORD=DefinirContrasenaFuerteAqui123!

# Claves de Autenticación y JWT (Obligatorio configurar en .env)
JWT_SECRET_KEY=generar_clave_segura_de_al_menos_32_caracteres_aleatorios
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@sistemas.com


