# Configuración de Base de Datos MongoDB (incluyendo GridFS)
# Para despliegue en Docker Compose (conexión al contenedor mongodb):
MONGO_URI=mongodb://mongodb:27017/tickets_db
MONGO_DB_NAME=tickets_db

# (Opcional) Si ejecutas el backend en tu PC fuera de Docker (ej. run_backend.bat):
# MONGO_URI=mongodb://localhost:27017/tickets_db

# Orígenes CORS permitidos para el Frontend (incluyendo puerto 8085 de Caddy)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://localhost:8085", "http://ticketscoopya.duckdns.org", "https://ticketscoopya.duckdns.org", "http://ticketscoopya.duckdns.org:8085", "https://ticketscoopya.duckdns.org:8085"]

# Seguridad y Cuotas por Correo
MAX_DAILY_TICKETS_PER_EMAIL=8
TICKET_CREATION_COOLDOWN_SECONDS=60

# Lista blanca de administradores (sin límites de creación ni cooldown)
ADMIN_EMAILS=["nmonticoopya@gmail.com", "nfernandezcoopya@gmail.com", "fbernard@coopya.com.ar"]

